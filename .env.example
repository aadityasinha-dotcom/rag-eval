# Copy to .env. docker compose reads this file automatically.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_eval
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag_eval

# Embeddings (step 4+). Unused until ingest/embed.py exists.
# OPENAI_API_KEY=

# Instrumentation is optional (CLAUDE.md rule 8). Needs `uv sync --extra observe`
# and a key; with either missing the harness runs identically and sends nothing.
# LLM_METRICS_API_KEY=
# LLM_METRICS_HOST=            # your llm-observe deployment; default is the hosted API
